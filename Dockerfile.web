FROM node:22-alpine AS frontend-build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

COPY index.html vite.config.js ./
COPY public ./public
COPY src ./src
RUN npm run build

FROM caddy:2-alpine

COPY Caddyfile.production /etc/caddy/Caddyfile
COPY --from=frontend-build /app/dist /srv
