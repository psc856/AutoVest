# Copy to .env.production ON THE SERVER. Never commit the filled file.
APP_ENV=production
DEPLOYMENT_ID=autoinvest-production
# Caddy serves React and FastAPI from this one HTTPS origin.
APP_DOMAIN=invest.example.com
FRONTEND_ORIGIN=https://invest.example.com

# Reuse the existing stable encryption key and Upstash WRITE credentials.
KV_REST_API_URL=https://your-upstash-endpoint.upstash.io
KV_REST_API_TOKEN=replace-with-write-token
KITE_TOKEN_ENCRYPTION_KEY=replace-with-your-existing-fernet-key

# Start disabled for deployment checks. Follow PRODUCTION_DEPLOYMENT.md before
# changing this to live and starting the persistent order worker.
AUTO_TRADE_MODE=disabled

# Operator ceilings. UI risk settings cannot exceed these limits.
TRADE_MAX_RISK_PER_TRADE=1000
TRADE_MAX_DAILY_LOSS=3000
TRADE_MAX_POSITION_VALUE=25000
TRADE_MAX_POSITIONS=5
TRADE_MAX_ACCOUNT_EXPOSURE=100000
